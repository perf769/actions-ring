<Window x:Class="ActionsRing.App.Windows.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ActionsRing.App.Controls"
        Title="Настройка действия"
        Width="650"
        Height="650"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="EditorTitle" Style="{StaticResource SectionTitleText}" Text="Настроить действие" TextWrapping="Wrap" Margin="0,0,12,0" />
                <TextBlock x:Name="EditorSubtitle" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoftBrush}">
                <controls:ActionIconView x:Name="HeaderIcon" Width="32" Height="32"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,14">
                <TextBlock Text="Название" Style="{StaticResource CaptionText}" Margin="2,0,0,7" />
                <TextBox x:Name="NameBox" MaxLength="80" />

                <TextBlock Text="Иконка" Style="{StaticResource CaptionText}" Margin="2,17,0,7" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="IconChoiceText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Автоматически" Click="OnAutomaticIcon" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Выбрать…" Click="OnPickIcon" Margin="8,0,0,0" />
                </Grid>

                <Border Margin="0,20,0,0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <StackPanel x:Name="ShortcutPanel" Visibility="Collapsed">
                            <TextBlock Text="Сочетание клавиш" Style="{StaticResource SectionTitleText}" FontSize="16" />
                            <TextBlock Text="Можно сохранить последовательность нескольких сочетаний." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                            <ItemsControl x:Name="ChordItems" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RecordChordButton" Style="{StaticResource SecondaryButton}" Click="OnRecordChord" Content="Записать сочетание" />
                                <Button Style="{StaticResource SecondaryButton}" Click="OnClearChords" Content="Очистить" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="RecordHint" Text="После нажатия введите сочетание; Esc отменяет." Style="{StaticResource CaptionText}" Margin="0,10,0,0" Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel x:Name="LaunchPanel" Visibility="Collapsed">
                            <TextBlock Text="Приложение, файл или папка" Style="{StaticResource SectionTitleText}" FontSize="16" />
                            <TextBlock Text="Путь" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="LaunchPathBox" MaxLength="4096" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Установленные…" Click="OnChooseInstalledApplication" Margin="8,0,0,0" />
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Файл…" Click="OnBrowseLaunch" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="Аргументы (необязательно)" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <TextBox x:Name="LaunchArgumentsBox" MaxLength="8192" />
                            <TextBlock Text="Рабочая папка (необязательно)" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <TextBox x:Name="WorkingDirectoryBox" MaxLength="4096" />
                            <CheckBox x:Name="RunAsAdminCheck" Content="Запрашивать запуск от администратора" Margin="0,15,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="UriPanel" Visibility="Collapsed">
                            <TextBlock Text="Веб-ссылка" Style="{StaticResource SectionTitleText}" FontSize="16" />
                            <TextBlock Text="Адрес URL" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <TextBox x:Name="UriBox" MaxLength="4096" />
                        </StackPanel>

                        <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                            <TextBlock Text="Текст" Style="{StaticResource SectionTitleText}" FontSize="16" />
                            <TextBlock Text="Текст будет введён в активное приложение." Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                            <TextBox x:Name="TextValueBox" Height="140" MaxLength="32768" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                            <TextBlock Text="Задержка между символами, мс" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <TextBox x:Name="CharacterDelayBox" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel x:Name="MousePanel" Visibility="Collapsed">
                            <TextBlock Text="Действие мыши" Style="{StaticResource SectionTitleText}" FontSize="16" />
                            <TextBlock Text="Кнопка или колесо" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <ComboBox x:Name="MouseButtonCombo" />
                            <TextBlock Text="Количество кликов" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <ComboBox x:Name="ClickCountCombo" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel x:Name="AdjustmentPanel" Visibility="Collapsed">
                            <TextBlock Text="Регулировка" Style="{StaticResource SectionTitleText}" FontSize="16" />
                            <TextBlock Text="Параметр" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <ComboBox x:Name="ParameterCombo" />
                            <TextBlock Text="Шаг изменения" Style="{StaticResource CaptionText}" Margin="0,14,0,6" />
                            <TextBox x:Name="AdjustmentValueBox" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel x:Name="SequencePanel" Visibility="Collapsed">
                            <TextBlock Text="Мульти-действие" Style="{StaticResource SectionTitleText}" FontSize="16" />
                            <TextBlock Text="Шаги выполняются сверху вниз. Задержка задаётся после шага." Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                            <ListBox x:Name="SequenceList" Height="210" SelectionChanged="OnSequenceSelectionChanged" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="+ Сочетание" Click="OnAddShortcutStep" Margin="0,0,7,7" />
                                <Button Style="{StaticResource SecondaryButton}" Content="+ Текст" Click="OnAddTextStep" Margin="0,0,7,7" />
                                <Button Style="{StaticResource SecondaryButton}" Content="+ Ссылка" Click="OnAddUriStep" Margin="0,0,7,7" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Изменить" Click="OnEditSequenceStep" Margin="0,0,7,7" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Удалить" Click="OnRemoveSequenceStep" Margin="0,0,7,7" />
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Задержка после шага" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="StepDelayBox" Grid.Column="1" Margin="10,0,0,0" LostFocus="OnStepDelayChanged" />
                                <TextBlock Grid.Column="2" Text="мс" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="BuiltInPanel" Visibility="Collapsed">
                            <TextBlock Text="Готовое системное действие" Style="{StaticResource SectionTitleText}" FontSize="16" />
                            <TextBlock Text="Дополнительных параметров нет." Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource DangerBrush}" Margin="2,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Отмена" Click="OnCancel" MinWidth="100" />
            <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnSave" MinWidth="110" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</Window>
