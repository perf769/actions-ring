<Window x:Class="ActionsRing.App.Windows.InstalledApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор приложения"
        Width="720" Height="650" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Установленные приложения" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="Доступны обычные программы и приложения Microsoft Store." Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <TextBox x:Name="SearchBox" Padding="12,9,38,9" TextChanged="OnSearchChanged" ToolTip="Поиск приложения" />
            <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Content="×"
                    FontFamily="{DynamicResource UiFont}" FontSize="17" Width="30" Height="30" Margin="0,0,4,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                    Click="OnClearSearch" ToolTip="Очистить поиск" />
        </Grid>
        <Grid Grid.Row="2">
            <ListBox x:Name="ApplicationsList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnItemDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFont}" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Ищем приложения…" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
            </StackPanel>
            <TextBlock x:Name="EmptyText" Text="Ничего не найдено" Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource SecondaryButton}" Content="Выбрать файл…" Click="OnBrowse" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Отмена" IsCancel="True" MinWidth="92" />
            <Button x:Name="SelectButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Выбрать" Click="OnSelect" IsEnabled="False" MinWidth="104" Margin="9,0,0,0" />
        </Grid>
    </Grid>
</Window>
