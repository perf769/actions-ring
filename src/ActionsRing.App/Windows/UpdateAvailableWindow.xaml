<Window x:Class="ActionsRing.App.Windows.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление Actions Ring"
        Width="650" Height="650" MinWidth="520" MinHeight="500"
        MaxWidth="780" MaxHeight="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
    <Grid x:Name="RootLayout" Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderPanel">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="HeaderIconSurface" Width="58" Height="58" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18">
                <TextBlock x:Name="HeaderIcon" Text="&#xE895;" FontFamily="{DynamicResource IconFont}" FontSize="25" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel x:Name="HeaderCopy" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" Text="Доступна новая версия" Style="{StaticResource SectionTitleText}" FontSize="24" />
                <TextBlock x:Name="VersionTransitionText" Text="2.0.0  →  2.1.0" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <Border x:Name="ReleaseBanner" Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource AccentBrush}" Margin="0,1,10,0" />
                <TextBlock x:Name="ReleaseDateText" Grid.Column="1" Text="Опубликовано сегодня" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <Border x:Name="ReleaseNotesCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="20" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="ReleaseNotesHeading" Text="Что изменилось" FontSize="16" FontWeight="SemiBold" />
                <ScrollViewer x:Name="ReleaseNotesScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,13,0,0">
                    <TextBlock x:Name="ReleaseNotesText"
                               Text="Улучшения и исправления новой версии."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               LineHeight="21"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel x:Name="InstallDetailsPanel" Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="InstallCaption" Text="После подтверждения Actions Ring закроется, установится для текущего пользователя и запустится снова."
                       Style="{StaticResource CaptionText}" TextAlignment="Center" />
            <StackPanel x:Name="DownloadPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DownloadStatusText" Text="Загрузка обновления…" FontWeight="SemiBold" />
                    <TextBlock x:Name="DownloadPercentText" Grid.Column="1" Text="0%" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <ProgressBar x:Name="DownloadProgress" Height="7" Minimum="0" Maximum="100" Margin="0,9,0,0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="ActionsPanel" Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Style="{StaticResource SecondaryButton}" Content="Пропустить версию" Click="OnSkip" MinWidth="150" />
            <Button x:Name="LaterButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Позже" Click="OnLater" IsCancel="True" MinWidth="96" />
            <Button x:Name="InstallButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Установить" Click="OnInstall" MinWidth="136" Margin="9,0,0,0" />
        </Grid>
    </Grid>
</Window>
