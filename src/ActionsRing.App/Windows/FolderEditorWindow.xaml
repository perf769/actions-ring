<Window x:Class="ActionsRing.App.Windows.FolderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ActionsRing.App.Controls"
        Title="Настройка подменю"
        Width="600"
        Height="700"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
    <Grid x:Name="LayoutRoot" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel">
            <TextBlock Text="Пузырь с подменю" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="Подменю открывается при наведении. На нажатие можно назначить отдельное действие."
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="FolderContentScroller" Grid.Row="1" Margin="0,22,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="FolderCard" Style="{StaticResource CardBorder}" Margin="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="Название" Style="{StaticResource CaptionText}" Margin="2,0,0,7" />
                    <TextBox x:Name="NameBox" MaxLength="80" />

                    <Grid x:Name="SlotCountPanel" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Количество пузырей" FontWeight="SemiBold" />
                            <TextBlock Text="От 1 до 9 действий в подменю."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,18,0" />
                        </StackPanel>
                        <TextBlock x:Name="SlotCountText" Grid.Column="1" Text="6" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
                    </Grid>
                    <Slider x:Name="SlotCountSlider" Minimum="1" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True"
                            Margin="0,14,0,0" ValueChanged="OnSlotCountChanged" />

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,18" />
                    <TextBlock Text="Действие по клику" FontWeight="SemiBold" />
                    <TextBlock Text="Например, открыть приложение или выполнить сочетание клавиш."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <controls:ActionIconView x:Name="ClickActionIcon" Width="28" Height="28" HorizontalAlignment="Left"
                                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceRaisedBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ClickActionName" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ClickActionDescription" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="ChooseClickActionButton" Content="Выбрать действие" Style="{StaticResource SecondaryButton}"
                                Click="OnChooseClickAction" Margin="0,8,0,0" />
                        <Button x:Name="ConfigureClickActionButton" Content="Изменить" Style="{StaticResource SecondaryButton}"
                                Click="OnConfigureClickAction" Margin="8,8,0,0" />
                        <Button x:Name="RemoveClickActionButton" Content="Убрать" Style="{StaticResource SecondaryButton}"
                                Click="OnRemoveClickAction" Margin="8,8,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid x:Name="FooterPanel" Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Отмена" Click="OnCancel" MinWidth="100" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnSave" MinWidth="110" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</Window>
