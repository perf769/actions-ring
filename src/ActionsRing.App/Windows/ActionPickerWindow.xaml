<Window x:Class="ActionsRing.App.Windows.ActionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ActionsRing.App.Controls"
        Title="Выбор действия" Width="800" Height="660" MinWidth="560" MinHeight="350"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid x:Name="LayoutRoot" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Действие по клику" Style="{StaticResource SectionTitleText}"/>
            <TextBlock x:Name="SubtitleText" Text="Выберите категорию или найдите нужное действие."
                       Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid x:Name="SearchPanel" Grid.Row="1" Margin="0,18,0,16">
            <TextBox x:Name="SearchBox" Padding="14,11,40,11" TextChanged="OnSearchChanged"
                     AutomationProperties.Name="Поиск действий" ToolTip="Поиск по названию, описанию и сочетанию клавиш"/>
            <TextBlock x:Name="SearchPlaceholder" Text="Поиск действий…" Style="{StaticResource CaptionText}"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0,40,0"/>
            <Button x:Name="ClearSearchButton" Content="×" FontFamily="{DynamicResource UiFont}" FontSize="18"
                    Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,6,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                    Click="OnClearSearch" ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="CategoryList" Margin="0,0,12,0" Background="Transparent" BorderThickness="0" Padding="0"
                     HorizontalContentAlignment="Stretch" SelectionChanged="OnCategoryChanged" AutomationProperties.Name="Категории действий">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="5">
                <Grid>
                    <ListBox x:Name="ActionsList" Background="Transparent" BorderThickness="0" Padding="0"
                             HorizontalContentAlignment="Stretch" SelectionChanged="OnActionSelected" MouseDoubleClick="OnActionDoubleClick"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.CanContentScroll="True"
                             AutomationProperties.Name="Доступные действия">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                   Margin="12,13,12,7" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="46" Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <controls:ActionIconView Width="22" Height="22" Foreground="{DynamicResource AccentBrush}"
                                                                 Background="{DynamicResource AccentSoftBrush}" Loaded="OnActionIconLoaded"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed">
                        <TextBlock Text="Ничего не найдено" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Попробуйте другое название или категорию." Style="{StaticResource CaptionText}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ResultCountText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Отмена" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="92"/>
            <Button x:Name="SelectButton" Grid.Column="2" Content="Назначить" Style="{StaticResource PrimaryButton}"
                    Click="OnSelect" IsDefault="True" IsEnabled="False" MinWidth="110" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
