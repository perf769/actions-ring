<Window x:Class="ActionsRing.App.Windows.KeyStateOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="256"
        Height="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="NotificationCard"
            Margin="10"
            Padding="16,13"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="17"
            Effect="{StaticResource SoftShadow}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTranslate" Y="-8" />
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="12">
                <TextBlock x:Name="KeyGlyph"
                           Text="A"
                           FontFamily="{DynamicResource DisplayFont}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                <TextBlock x:Name="KeyNameText"
                           Text="Caps Lock"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Ellipse x:Name="StateDot"
                             Width="7"
                             Height="7"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="StateText"
                               Text="Включён"
                               Style="{StaticResource CaptionText}"
                               FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
