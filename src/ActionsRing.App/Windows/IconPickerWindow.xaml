<Window x:Class="ActionsRing.App.Windows.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ActionsRing.App.Controls"
        Title="Иконка пузыря" Width="800" Height="690" MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabSurface" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Opacity" Value="0.8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="HeadingPanel" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" Text="Выберите иконку" Style="{StaticResource SectionTitleText}"/>
                <TextBlock x:Name="SubtitleText" Text="Для действия, приложения или папки" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border x:Name="PreviewSurface" Grid.Column="1" Width="54" Height="54" Background="{DynamicResource SurfaceBrush}" CornerRadius="27" Margin="12,0,0,0">
                <controls:ActionIconView x:Name="PreviewIcon" Width="30" Height="30" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}"/>
            </Border>
        </Grid>
        <Grid x:Name="SearchPanel" Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" Padding="12,9,40,9" TextChanged="OnSearchChanged" ToolTip="Название иконки или приложения, на русском или английском"/>
            <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Content="×" FontFamily="{DynamicResource UiFont}" FontSize="18"
                    Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Click="OnClearSearch" ToolTip="Очистить поиск" Visibility="Collapsed"/>
        </Grid>
        <TabControl x:Name="SourceTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="OnSourceChanged">
            <TabItem Header="Библиотека">
                <Grid x:Name="LibraryPanel" Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="CategoryPanel" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="CategoryBox" Width="190" HorizontalAlignment="Left" SelectionChanged="OnCategoryChanged"/>
                        <TextBlock x:Name="ResultCountText" Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="IconsList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnIconSelected"
                             MouseDoubleClick="OnIconDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <Grid x:Name="PaginationPanel" Grid.Row="2" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="PreviousButton" Style="{StaticResource SecondaryButton}" Content="←" Width="48" Click="OnPrevious" ToolTip="Предыдущая страница"/>
                        <TextBlock x:Name="PageText" Grid.Column="1" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="→" Width="48" Click="OnNext" ToolTip="Следующая страница"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Приложения">
                <Grid Margin="0,12,0,0">
                    <ListBox x:Name="ApplicationsList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="OnApplicationSelected" MouseDoubleClick="OnIconDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    <TextBlock x:Name="ApplicationsStatusText" Text="Ищем установленные приложения…" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            <TabItem Header="Свой файл">
                <StackPanel x:Name="ImportPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                    <controls:ActionIconView x:Name="ImportIllustration" Width="48" Height="48" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ImportHeadingText" Text="Ваша иконка" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ImportDescriptionText" Text="SVG, PNG, ICO или JPG · до 8 МБ" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,7,0,18"/>
                    <Button x:Name="ImportButton" Content="Выбрать файл…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="OnImport"/>
                    <TextBlock x:Name="ImportStatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Автоматически" Style="{StaticResource SecondaryButton}" Click="OnAutomatic" ToolTip="Использовать иконку действия или приложения"/>
            <Button Grid.Column="2" Content="Отмена" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button x:Name="SelectButton" Grid.Column="3" Content="Выбрать" Style="{StaticResource PrimaryButton}" Click="OnSelect" IsEnabled="False" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
