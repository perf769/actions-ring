<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ActionsRing</AssemblyName>
    <RootNamespace>ActionsRing.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Assets\ActionsRing.ico</ApplicationIcon>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <AssemblyTitle>Actions Ring</AssemblyTitle>
    <Product>Actions Ring</Product>
    <Company>Actions Ring</Company>
    <Description>Fast, app-aware radial actions menu for Windows.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActionsRing.Core\ActionsRing.Core.csproj" />
    <ProjectReference Include="..\ActionsRing.Platform.Windows\ActionsRing.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ActionsRingLogo.png" />
    <EmbeddedResource Include="Assets\Icons\catalog.json" />
    <EmbeddedResource Include="Assets\Icons\*-LICENSE.txt" />
    <EmbeddedResource Include="Assets\Icons\SIMPLE-ICONS-DISCLAIMER.md" />
  </ItemGroup>
</Project>
